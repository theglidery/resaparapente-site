---
import Base from '../layouts/Base.astro';
import { schoolHref } from '../i18n/routes.mjs';
import Mountains from '../components/Mountains.astro';
import { MARKET } from '../config';
import { href } from '../i18n/ui';
import { schools, cities, offerPrice, currencyOf, LEVELS } from '../lib/data';
import { packagesL, examFeesL, examTotal, money, dateLoc, host, type Loc } from '../lib/compare';

const { locale = 'fr' } = Astro.props as { locale?: Loc };
const isEn = locale === 'en';
const isDe = locale === 'de';

const stageRows = schools
  .flatMap((s) => {
    const cur = currencyOf(s);
    const country = s.country || 'FR';
    return s.stages
      .map((o) => {
        const rawPrice = offerPrice(o) ?? o.price ?? null;
        if (rawPrice == null || rawPrice <= 0) return null;
        const dur = o.durText ?? (o.durMin ? `${o.durMin}${o.durMax && o.durMax !== o.durMin ? `–${o.durMax}` : ''} ${o.durUnit ?? 'jours'}` : '—');
        const isPerDay = o.unitCode === 'JOUR';
        const daysMatch = typeof dur === 'string' ? dur.match(/(\d+)\s*jour/i) : null;
        const days = isPerDay ? (o.durMin && o.durMin > 1 ? o.durMin : daysMatch ? Number(daysMatch[1]) : 1) : 1;
        const price = isPerDay && days > 1 ? rawPrice * days : rawPrice;
        return {
          id: o.id,
          school: s.name,
          slug: s.slug,
          country,
          currency: cur,
          city: s.city || '',
          region: s.region && s.region !== 'À vérifier' ? s.region : '',
          lat: s.lat,
          lng: s.lng,
          near: s.nearCities,
          levelKey: o.levelKey || 'autre',
          levelName: o.levelName || 'Autres stages',
          offer: o.name,
          dur,
          price,
          dayPrice: isPerDay && days > 1 ? rawPrice : null,
          days: isPerDay && days > 1 ? days : null,
          checked: o.checked,
        };
      })
      .filter((x): x is NonNullable<typeof x> => Boolean(x));
  })
  .sort((a, b) => a.price - b.price || a.school.localeCompare(b.school, 'fr'));

const regions = [...new Set(stageRows.map((r) => r.region).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'fr'));
const regionCountryMap = Object.fromEntries(stageRows.filter((r) => r.region).map((r) => [r.region, r.country]));
const packages = packagesL(locale);
const examFees = examFeesL(locale);

const L = isEn
  ? {
      title: 'Paragliding course comparator: compare trainings by type, region and price',
      desc: `Compare ${stageRows.length} paragliding courses by training type, country, region, nearby city and price.`,
      h1: 'Paragliding course comparator',
      lead: `${stageRows.length} published courses ranked by price. Pick the training type and area to compare.`,
      type: 'Training type',
      allTypes: 'All training types',
      country: 'Country',
      allCountries: 'All countries',
      region: 'Region',
      allRegions: 'All regions',
      city: 'Near city',
      cityPh: 'Annecy, Grenoble, Chamonix…',
      dist: 'Max distance',
      noLimit: 'No limit',
      currency: 'Currency',
      sort: 'Sort by',
      sPrice: 'Lowest price',
      sDist: 'Distance',
      sSchool: 'School name',
      reset: 'Reset',
      count: 'courses found',
      none: 'No course matches these criteria. Try widening a filter.',
      cOffer: 'Course and school',
      cType: 'Type',
      cDur: 'Duration',
      cPrice: 'Price',
      go: 'See school',
      feesTitle: 'Known federation and licence fees',
      next: 'Keep going',
    }
  : isDe
  ? {
      title: 'Gleitschirmkurs-Vergleich: Kurse nach Typ, Region und Preis',
      desc: `Vergleichen Sie ${stageRows.length} Gleitschirmkurse nach Kurstyp, Land, Region, Stadt und Preis.`,
      h1: 'Gleitschirmkurs-Vergleich',
      lead: `${stageRows.length} veröffentlichte Kurse nach Preis sortiert. Wählen Sie Kurstyp und Region.`,
      type: 'Kurstyp',
      allTypes: 'Alle Kurstypen',
      country: 'Land',
      allCountries: 'Alle Länder',
      region: 'Region',
      allRegions: 'Alle Regionen',
      city: 'In der Nähe von',
      cityPh: 'Davos, Interlaken, Annecy…',
      dist: 'Max. Entfernung',
      noLimit: 'Kein Limit',
      currency: 'Währung',
      sort: 'Sortieren nach',
      sPrice: 'Günstigster Preis',
      sDist: 'Entfernung',
      sSchool: 'Schulname',
      reset: 'Zurücksetzen',
      count: 'Kurse gefunden',
      none: 'Kein Kurs entspricht diesen Kriterien.',
      cOffer: 'Kurs und Schule',
      cType: 'Typ',
      cDur: 'Dauer',
      cPrice: 'Preis',
      go: 'Zur Schule',
      feesTitle: 'Bekannte Verbands- und Lizenzgebühren',
      next: 'Weiterlesen',
    }
  : {
      title: 'Comparateur de stages de parapente : prix, type de stage, région et ville',
      desc: `Comparez ${stageRows.length} stages de parapente par type de stage, pays, région, ville proche et prix.`,
      h1: 'Comparateur de stages de parapente',
      lead: `${stageRows.length} stages publiés classés par prix croissant. Choisissez le type de stage et la zone recherchée.`,
      type: 'Type de stage',
      allTypes: 'Tous les types de stage',
      country: 'Pays',
      allCountries: 'Tous les pays',
      region: 'Région',
      allRegions: 'Toutes les régions',
      city: 'Près de quelle ville ?',
      cityPh: 'Annecy, Grenoble, Chamonix…',
      dist: 'Distance max',
      noLimit: 'Pas de limite',
      currency: 'Devise',
      sort: 'Trier par',
      sPrice: 'Prix croissant',
      sDist: 'Distance',
      sSchool: 'Nom de l’école',
      reset: 'Réinitialiser',
      count: 'stages affichés',
      none: 'Aucun stage ne correspond à ces critères. Élargissez un filtre.',
      cOffer: 'Stage et école',
      cType: 'Type',
      cDur: 'Durée',
      cPrice: 'Prix publié',
      go: 'Voir l’école',
      feesTitle: 'Frais de fédération et de brevet connus',
      next: 'Pour aller plus loin',
    };
---
<Base title={L.title} description={L.desc} locale={locale} pageKey="trainingCost">
  <div class="page-head" style="padding-bottom:0.8rem">
    <div class="wrap">
      <h1>{L.h1}</h1>
      <p class="lead" style="margin-bottom:0">{L.lead}</p>
    </div>
    <Mountains />
  </div>

  <div class="wrap section cmp" data-cmp="stage" style="padding-top:0.6rem">
    <form class="filters cmp-filters" id="stage-cmp-form" onsubmit="return false" style="margin-top:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(10.5rem,1fr));gap:0.75rem;align-items:end">
      <label style="display:grid;gap:0.25rem">
        <span>{L.type}</span>
        <select name="level">
          <option value="">{L.allTypes}</option>
          {LEVELS.filter((lv) => lv.key !== 'autre').map((lv) => (
            <option value={lv.key} selected={lv.key === 'initiation'}>{lv.name}</option>
          ))}
        </select>
      </label>
      <label style="display:grid;gap:0.25rem">
        <span>{L.country}</span>
        <select name="pays">
          <option value="FR" selected={MARKET.code === 'FR'}>France</option>
          <option value="CH" selected={MARKET.code === 'CH'}>Suisse</option>
          <option value="BE" selected={MARKET.code === 'BE'}>Belgique</option>
          <option value="all">{L.allCountries}</option>
        </select>
      </label>
      <label style="display:grid;gap:0.25rem">
        <span>{L.region}</span>
        <select name="region">
          <option value="">{L.allRegions}</option>
          {regions.map((r) => <option value={r} data-country={regionCountryMap[r] || 'FR'}>{r}</option>)}
        </select>
      </label>
      <label style="display:grid;gap:0.25rem">
        <span>{L.city}</span>
        <input type="search" name="q" list="stage-cmp-cities" autocomplete="off" placeholder={L.cityPh} />
        <datalist id="stage-cmp-cities">{cities.map((c) => <option value={c.name} />)}</datalist>
      </label>
      <label style="display:grid;gap:0.25rem">
        <span>{L.dist}</span>
        <select name="r">
          <option value="">{L.noLimit}</option>
          <option value="25">25 km</option>
          <option value="50" selected>50 km</option>
          <option value="100">100 km</option>
          <option value="200">200 km</option>
        </select>
      </label>
      <label style="display:grid;gap:0.25rem">
        <span>{L.currency}</span>
        <select name="currency">
          <option value="EUR" selected={MARKET.currency === 'EUR'}>EUR (€)</option>
          <option value="CHF" selected={MARKET.currency === 'CHF'}>CHF</option>
        </select>
      </label>
      <label style="display:grid;gap:0.25rem">
        <span>{L.sort}</span>
        <select name="sort">
          <option value="price">{L.sPrice}</option>
          <option value="distance">{L.sDist}</option>
          <option value="school">{L.sSchool}</option>
        </select>
      </label>
      <div class="btn-row"><button class="btn ghost small" type="reset">{L.reset}</button></div>
    </form>

    <p class="cmp-count" role="status" aria-live="polite"><strong id="stage-cmp-n">{stageRows.length}</strong> {L.count}</p>
    <div class="table-wrap">
      <table class="data-table cmp-table">
        <thead>
          <tr>
            <th style="min-width:22rem;width:44%">{L.cOffer}</th>
            <th>{L.cType}</th>
            <th>{L.cDur}</th>
            <th>{L.cPrice}</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="stage-cmp-body">
          {stageRows.map((r) => (
            <tr
              class="stage-cmp-row"
              data-level={r.levelKey}
              data-country={r.country}
              data-currency={r.currency}
              data-region={r.region}
              data-city={r.city.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()}
              data-near={r.near.map((x) => x.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()).join('|')}
              data-lat={r.lat ?? ''}
              data-lng={r.lng ?? ''}
              data-price={r.price}
              data-school={r.school.toLowerCase()}
            >
              <th scope="row">
                <strong>{r.offer}</strong>
                <span class="small muted">
                  {r.school}{r.city ? ` · ${r.city}` : ''}{r.region ? ` · ${r.region}` : ''}<span class="stage-dist"></span>
                </span>
              </th>
              <td class="small" data-label={L.cType}>{r.levelName}</td>
              <td class="small nowrap" data-label={L.cDur}>{r.dur}</td>
              <td class="nowrap" data-label={L.cPrice}>
                <strong>{money(r.price, locale, r.currency)}</strong>
                {r.dayPrice && r.days && <span class="small muted" style="display:block">{money(r.dayPrice, locale, r.currency)}/{isEn ? 'day' : isDe ? 'Tag' : 'j'} × {r.days}</span>}
              </td>
              <td class="nowrap">
                <a class="btn small ghost" href={`${schoolHref(r.slug, locale)}?parcours=stage`}>{L.go}</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="empty" id="stage-cmp-empty" hidden>{L.none}</p>

    {examFees.length > 0 && (
      <section style="margin-top:2.5rem">
        <h2>{L.feesTitle}</h2>
        <div class="table-wrap">
          <table class="data-table">
            <thead><tr><th>Poste</th><th>Montant</th><th>Organisme</th></tr></thead>
            <tbody>
              {examFees.map((f) => (
                <tr>
                  <th scope="row">{f.item}</th>
                  <td>{money(f.amount, locale)}</td>
                  <td class="small">{f.body}{f.source && <> · <a href={f.source} target="_blank" rel="noopener">{host(f.source)}</a></>}{f.checked && ` · ${dateLoc(f.checked, locale, { day: 'numeric', month: 'short', year: 'numeric' })}`}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
  </div>
  <script type="application/json" id="stage-cmp-towns" set:html={JSON.stringify(cities.map(({ name, lat, lng, region, ...rest }: any) => ({ name, lat, lng, region, country: rest.country || 'FR' })))} />
</Base>
<script>import '../scripts/cmp-path.js';</script>
