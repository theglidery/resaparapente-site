---
import CalendarPage from '../components/CalendarPage.astro';
import ListingPage from '../components/ListingPage.astro';
const { locale = 'en', page } = Astro.props as { locale?: 'fr' | 'en' | 'de'; page: string };
const view = page === 'listBapteme' ? 'bapteme' : page === 'listStage' ? 'stage' : 'calendrier';
---
{view === 'calendrier'
  ? <CalendarPage locale={locale} />
  : <ListingPage kind={view} locale={locale} />}
