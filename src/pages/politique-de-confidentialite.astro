---
import DocPage from '../components/DocPage.astro';
import rawPrivacy from '../../legal/pages/confidentialite-fr.html?raw';

const html = rawPrivacy
  .replace(/\{\{cgvUrl\}\}/g, '/conditions-generales-de-vente/')
  .replace(/\{\{privacyUrl\}\}/g, '/politique-de-confidentialite/');
---
<DocPage
  title="Politique de confidentialité"
  description="Quelles données ResaParapente collecte, pourquoi, avec qui elles sont partagées, combien de temps elles sont conservées et comment exercer vos droits."
>
  <p class="muted">Version du 22 novembre 2026</p>
  <div set:html={html} />
</DocPage>
<style>
  :global(mark.todo) { background: #fef08a; color: #713f12; padding: 0.05em 0.3em; border-radius: 4px; font-weight: 600; }
</style>
