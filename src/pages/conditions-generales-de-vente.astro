---
import DocPage from '../components/DocPage.astro';
import rawCgv from '../../legal/pages/cgv-clients-fr.html?raw';
import { MARKET } from '../config';

const html = rawCgv
  .replace(/\{\{cgvUrl\}\}/g, '/conditions-generales-de-vente/')
  .replace(/\{\{privacyUrl\}\}/g, '/politique-de-confidentialite/');
---
<DocPage
  title="Conditions du site (CGV)"
  h1="Conditions générales du site ResaParapente"
  description="Conditions applicables aux utilisateurs de ResaParapente : demandes de réservation gratuites, demandes de bon cadeau, sécurité, référencement, données personnelles et droit applicable."
>
  <p class="muted">Version du 22 novembre 2026</p>
  <p class="notice">Ces conditions s’appliquent à l’utilisation de resaparapente.fr, resaparapente.ch et resaparapente.be. Les passages surlignés (<mark class="todo">à compléter</mark>) doivent être renseignés avant la mise en production.</p>
  <div id="cgv-content" data-market={MARKET.code.toLowerCase()} set:html={html} />
</DocPage>
<style>
  :global(mark.todo) { background: #fef08a; color: #713f12; padding: 0.05em 0.3em; border-radius: 4px; font-weight: 600; }
</style>
