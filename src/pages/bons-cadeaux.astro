---
import Base from '../layouts/Base.astro';
import Mountains from '../components/Mountains.astro';
import ConsentBoxes from '../components/ConsentBoxes.astro';
import { schools, giftsOf, offerPrice, eur, currencyOf } from '../lib/data';
import { MARKET } from '../config';

const rows = schools
  .flatMap((s) => {
    const hasSchoolGift = giftsOf(s.id).length > 0;
    const cur = currencyOf(s);
    return s.baptemes.map((o) => {
      const p = offerPrice(o) ?? o.price ?? null;
      const priceLabel = o.priceLabel ?? (p ? eur(p, cur) : 'Prix sur demande');
      return {
        schoolId: s.id,
        schoolName: s.name,
        schoolSlug: s.slug,
        country: s.country || 'FR',
        region: s.region || '',
        city: s.city || '',
        offerId: o.id,
        offerName: o.name,
        price: p,
        priceLabel,
        hasSchoolGift,
      };
    });
  })
  .sort((a, b) => (a.price ?? Infinity) - (b.price ?? Infinity) || a.offerName.localeCompare(b.offerName, 'fr'));

const countries = [...new Set(rows.map((r) => r.country))];
const regions = [...new Set(rows.map((r) => r.region).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'fr'));
const citiesByRegion: Record<string, string[]> = {};
for (const r of rows) {
  if (!r.region || !r.city) continue;
  citiesByRegion[r.region] ??= [];
  if (!citiesByRegion[r.region].includes(r.city)) citiesByRegion[r.region].push(r.city);
}
for (const k of Object.keys(citiesByRegion)) citiesByRegion[k].sort((a, b) => a.localeCompare(b, 'fr'));
const COUNTRY_LABELS: Record<string, string> = { FR: 'France', CH: 'Suisse', BE: 'Belgique' };
---
<Base
  title="Offrir un vol en parapente : toutes les formules de baptême"
  description="Choisissez une formule de baptême en parapente parmi toutes nos écoles partenaires : l’école vous envoie le bon cadeau et organise le paiement."
>
  <div class="page-head"><div class="wrap">
    <nav class="crumbs" aria-label="Fil d’Ariane"><a href="/">Accueil</a> / Offrir</nav>
    <h1>Offrir un vol en parapente</h1>
    <p class="lead">Choisissez une formule : l’école vous envoie le bon et organise le paiement. Toutes les formules de baptême sont proposées.</p>
  </div><Mountains /></div>

  <div class="wrap section" style="padding-top:1.2rem">
    <div class="school-layout">
      <aside class="filters-col" aria-label="Filtrer les formules">
        <form id="offrir-filters" class="card" style="padding:1rem 1.1rem;display:grid;gap:0.85rem">
          <h2 style="font-size:1.05rem;margin:0">Où voler ?</h2>
          <div class="field">
            <label for="of-country">Pays</label>
            <select id="of-country">
              {countries.map((c) => <option value={c} selected={c === MARKET.code}>{COUNTRY_LABELS[c] || c}</option>)}
              <option value="all">Tous les pays</option>
            </select>
          </div>
          <div class="field">
            <label for="of-region">Région</label>
            <select id="of-region">
              <option value="">Toutes les régions</option>
              {regions.map((r) => <option value={r}>{r}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="of-city">Ville</label>
            <select id="of-city" disabled>
              <option value="">Toutes les villes de la région</option>
            </select>
            <p class="small muted" style="margin:0.25rem 0 0">La liste des villes ne montre que celles de la région choisie.</p>
          </div>
          <div class="field">
            <label for="of-sort">Trier par</label>
            <select id="of-sort">
              <option value="price-asc">Prix croissant</option>
              <option value="price-desc">Prix décroissant</option>
              <option value="school">Nom de l’école</option>
            </select>
          </div>
        </form>
      </aside>

      <div class="offers-col">
        <p class="small muted" id="of-summary" style="margin:0 0 0.8rem">{rows.length} formules de baptême</p>
        <ul class="board" id="of-list" style="list-style:none;padding:0;display:grid;gap:0.75rem">
          {rows.map((r) => (
            <li
              class="offer card"
              style="padding:0.95rem 1.1rem;display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap"
              data-country={r.country}
              data-region={r.region}
              data-city={r.city}
              data-price={r.price ?? ''}
              data-school-name={r.schoolName}
              data-school-id={r.schoolId}
              data-school-slug={r.schoolSlug}
              data-offer-id={r.offerId}
              data-offer-name={r.offerName}
              data-price-label={r.priceLabel}
            >
              <div>
                <h3 style="margin:0 0 0.2rem;font-size:1.05rem">
                  {r.offerName}
                  {r.hasSchoolGift && (
                    <span style="margin-left:0.45rem;font-size:0.75rem;font-weight:600;padding:0.15rem 0.45rem;border-radius:999px;background:#fef3c7;color:#92400e">
                      Bon proposé par l’école
                    </span>
                  )}
                </h3>
                <p class="small muted" style="margin:0">
                  <a href={`/ecoles/${r.schoolSlug}/`} style="color:inherit">{r.schoolName}</a>
                  {r.city ? ` · ${r.city}` : ''}
                  {r.region ? ` · ${r.region}` : ''}
                </p>
              </div>
              <div style="display:flex;align-items:center;gap:0.9rem">
                <strong style="font-size:1.15rem">{r.priceLabel}</strong>
                <button type="button" class="btn ghost of-choose">🎁 Offrir</button>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <aside class="booking is-gift" id="of-panel" hidden aria-label="Offrir cette formule">
        <button type="button" class="btn ghost small sheet-close" id="of-close">Fermer</button>
        <form id="of-gift-form" method="post" novalidate data-endpoint="/api/gift-request">
          <h2>Offrir cette formule</h2>
          <p class="small muted" style="margin:0 0 0.8rem">Demande gratuite. L’école vous contacte pour vous envoyer le bon et organiser le paiement. Aucun paiement sur le site.</p>
          <div id="of-chosen" class="chosen" aria-live="polite"></div>
          <fieldset>
            <legend>Vous qui offrez</legend>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.6rem">
              <div class="field"><label for="og-first">Prénom *</label><input id="og-first" type="text" autocomplete="given-name" required /></div>
              <div class="field"><label for="og-last">Nom *</label><input id="og-last" type="text" autocomplete="family-name" required /></div>
            </div>
            <div class="field"><label for="og-email">Email *</label><input id="og-email" type="email" autocomplete="email" required /></div>
            <div class="field"><label for="og-phone">Téléphone *</label><input id="og-phone" type="tel" autocomplete="tel" inputmode="tel" required /></div>
          </fieldset>
          <fieldset>
            <legend>Le passager</legend>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.6rem">
              <div class="field"><label for="ogp-first">Prénom *</label><input id="ogp-first" type="text" autocomplete="off" required /></div>
              <div class="field"><label for="ogp-last">Nom *</label><input id="ogp-last" type="text" autocomplete="off" required /></div>
            </div>
            <div class="field"><label for="ogp-email">Email *</label><input id="ogp-email" type="email" autocomplete="off" required /></div>
            <div class="field"><label for="ogp-phone">Téléphone *</label><input id="ogp-phone" type="tel" inputmode="tel" autocomplete="off" required /></div>
            <div class="field"><label for="ogp-weight">Poids (kg) *</label><input id="ogp-weight" type="number" inputmode="numeric" min="15" max="200" step="1" placeholder="ex. 72" required /></div>
            <div class="field"><label for="ogp-month">Date de vol souhaitée (approximative)</label><input id="ogp-month" type="text" maxlength="60" placeholder="ex. juillet 2027" /></div>
            <div class="field"><label for="ogp-msg">Un message pour le passager (facultatif)</label><textarea id="ogp-msg" rows="2" maxlength="400"></textarea></div>
          </fieldset>
          <ConsentBoxes schoolName="l’école" isGift={true} prefix="og" />
          <input type="text" id="og-website" name="website" hidden tabindex="-1" autocomplete="off" />
          <button class="btn" type="submit" disabled style="width:100%;margin-top:1rem">Envoyer ma demande de bon cadeau</button>
          <div id="og-msg" role="status" class="small" tabindex="-1"></div>
        </form>
      </aside>
    </div>
  </div>
  <script type="application/json" id="of-cities-map" set:html={JSON.stringify(citiesByRegion)} />
</Base>
<script>
  const $ = (s: string, r: ParentNode = document) => r.querySelector(s) as any;
  const $$ = (s: string, r: ParentNode = document) => [...r.querySelectorAll(s)] as HTMLElement[];
  const okEmail = (x: string) => /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(x);
  const citiesMap: Record<string, string[]> = JSON.parse($('#of-cities-map').textContent || '{}');

  const fCountry = $('#of-country') as HTMLSelectElement;
  const fRegion = $('#of-region') as HTMLSelectElement;
  const fCity = $('#of-city') as HTMLSelectElement;
  const fSort = $('#of-sort') as HTMLSelectElement;
  const list = $('#of-list') as HTMLElement;
  const summary = $('#of-summary') as HTMLElement;
  const items = $$('li[data-offer-id]', list);

  function syncCities() {
    const reg = fRegion.value;
    fCity.innerHTML = '<option value="">Toutes les villes de la région</option>';
    if (!reg || !citiesMap[reg]) {
      fCity.disabled = true;
      return;
    }
    fCity.disabled = false;
    for (const c of citiesMap[reg]) {
      const opt = document.createElement('option');
      opt.value = c;
      opt.textContent = c;
      fCity.appendChild(opt);
    }
  }

  function applyFilters() {
    const c = fCountry.value;
    const reg = fRegion.value;
    const city = fCity.value;
    const sort = fSort.value;
    let visible = 0;
    for (const li of items) {
      const ok = (c === 'all' || li.dataset.country === c) && (!reg || li.dataset.region === reg) && (!city || li.dataset.city === city);
      li.hidden = !ok;
      if (ok) visible += 1;
    }
    const sorted = [...items].sort((a, b) => {
      const pa = a.dataset.price ? Number(a.dataset.price) : Infinity;
      const pb = b.dataset.price ? Number(b.dataset.price) : Infinity;
      if (sort === 'price-desc') return (pb === Infinity ? -1 : pb) - (pa === Infinity ? -1 : pa);
      if (sort === 'school') return (a.dataset.schoolName || '').localeCompare(b.dataset.schoolName || '', 'fr');
      return pa - pb;
    });
    for (const li of sorted) list.appendChild(li);
    summary.textContent = `${visible} formule${visible > 1 ? 's' : ''} de baptême`;
  }

  fCountry.addEventListener('change', () => { fRegion.value = ''; syncCities(); applyFilters(); });
  fRegion.addEventListener('change', () => { syncCities(); applyFilters(); });
  fCity.addEventListener('change', applyFilters);
  fSort.addEventListener('change', applyFilters);
  applyFilters();

  const panel = $('#of-panel') as HTMLElement;
  const gForm = $('#of-gift-form') as HTMLFormElement;
  const gChosen = $('#of-chosen') as HTMLElement;
  const gMsg = $('#og-msg') as HTMLElement;
  const gBtn = $('button[type=submit]', gForm) as HTMLButtonElement;
  const gBox1 = $('[data-consent-box="1"]', gForm) as HTMLInputElement;
  const gBox2 = $('[data-consent-box="2"]', gForm) as HTMLInputElement;
  const gErr = $('.consent-err', gForm) as HTMLElement;
  const syncConsentBtn = () => {
    if (gBtn && gBox1) gBtn.disabled = !gBox1.checked;
    if (gErr && gBox1) gErr.hidden = gBox1.checked;
  };
  gBox1?.addEventListener('change', syncConsentBtn);
  syncConsentBtn();
  let activeLi: HTMLElement | null = null;
  let pending = false;
  let attempt: { signature: string; id: string; sent: boolean } | null = null;

  list.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.of-choose');
    if (!btn) return;
    const li = btn.closest('li[data-offer-id]') as HTMLElement | null;
    if (!li) return;
    activeLi = li;
    panel.hidden = false;
    gChosen.innerHTML = `<p style="margin:0"><strong>Bon cadeau · ${li.dataset.offerName}</strong><br><span class="muted small">${li.dataset.schoolName} · ${li.dataset.priceLabel}</span></p>`;
    gForm.querySelectorAll('.consent-info strong, .consent-gift-info strong').forEach((el) => { el.textContent = li.dataset.schoolName || 'l’école'; });
    (window as any).rpTrack?.('click_voucher', { offer_id: li.dataset.offerId, school_id: li.dataset.schoolId });
    panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  $('#of-close')?.addEventListener('click', () => { panel.hidden = true; });

  const val = (id: string) => ($(id)?.value || '').trim();
  gForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (pending || !activeLi) return;
    const errs: string[] = [];
    if (!val('#og-first')) errs.push('Indiquez votre prénom.');
    if (!val('#og-last')) errs.push('Indiquez votre nom.');
    if (!okEmail(val('#og-email'))) errs.push('Indiquez votre email.');
    if (val('#og-phone').replace(/\D/g, '').length < 8) errs.push('Indiquez votre téléphone.');
    if (!val('#ogp-first')) errs.push('Indiquez le prénom du passager.');
    if (!val('#ogp-last')) errs.push('Indiquez le nom du passager.');
    if (!okEmail(val('#ogp-email'))) errs.push('Indiquez l’email du passager.');
    if (val('#ogp-phone').replace(/\D/g, '').length < 8) errs.push('Indiquez le téléphone du passager.');
    const pw = Number(val('#ogp-weight'));
    if (!Number.isInteger(pw) || pw < 15 || pw > 200) errs.push('Indiquez le poids du passager (15 à 200 kg).');
    if (!($('#og-consent') as HTMLInputElement)?.checked) errs.push('Autorisez la transmission de votre demande à l’école.');
    if (errs.length) {
      gMsg.className = 'small error';
      gMsg.innerHTML = '<strong>À corriger :</strong><ul>' + errs.map((x) => `<li>${x}</li>`).join('') + '</ul>';
      gMsg.focus();
      return;
    }
    const grp = $('[data-consent-group]', gForm) as HTMLElement;
    const consents = {
      cgv: Boolean(gBox1?.checked),
      partners: Boolean(gBox2?.checked),
      version: grp?.dataset.consentVersion || '',
      market: grp?.dataset.consentMarket || 'fr',
      language: grp?.dataset.consentLang || 'fr',
    };
    const payload = {
      schoolId: activeLi.dataset.schoolId,
      offerId: activeLi.dataset.offerId,
      offerName: activeLi.dataset.offerName,
      offerKind: 'bapteme',
      offerPriceLabel: activeLi.dataset.priceLabel,
      giver: { firstName: val('#og-first'), lastName: val('#og-last'), email: val('#og-email'), phone: val('#og-phone') },
      passenger: { firstName: val('#ogp-first'), lastName: val('#ogp-last'), email: val('#ogp-email'), phone: val('#ogp-phone'), weightKg: pw, approxFlightMonth: val('#ogp-month') },
      message: val('#ogp-msg'),
      consent: true,
      consents,
      marketingOptIn: consents.partners,
      website: val('#og-website'),
    };
    const signature = JSON.stringify(payload);
    if (attempt?.signature !== signature) attempt = { signature, id: crypto.randomUUID(), sent: false };
    if (attempt.sent) return;
    pending = true;
    const btn = $('button[type=submit]', gForm) as HTMLButtonElement;
    btn.disabled = true;
    gMsg.className = 'small';
    gMsg.textContent = 'Envoi en cours…';
    try {
      const res = await fetch('/api/gift-request', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...payload, requestId: attempt.id }), signal: AbortSignal.timeout(12000),
      });
      const out = await res.json().catch(() => ({}));
      if (!res.ok || !out.ok || out.reference !== attempt.id) throw new Error(out.error || 'Envoi indisponible.');
      attempt.sent = true;
      location.assign(`/merci/cadeau/?${new URLSearchParams({
        ref: attempt.id,
        ecole: activeLi.dataset.schoolName || '',
        slug: activeLi.dataset.schoolSlug || '',
        school_id: activeLi.dataset.schoolId || '',
        offer: activeLi.dataset.offerName || '',
        offer_id: activeLi.dataset.offerId || '',
        price: activeLi.dataset.priceLabel || '',
        route: out.route || 'school',
        ...(out.test ? { test: '1' } : {}),
      })}`);
    } catch (err: any) {
      gMsg.className = 'small error';
      gMsg.textContent = err.message || 'Envoi non confirmé.';
    } finally {
      pending = false;
      btn.disabled = false;
      gMsg.focus();
    }
  });
</script>
