---
import Base from '../layouts/Base.astro';
import { sessions, schools, withOffers, regionCounts, dateFr, eur, LEVELS, sessionHref } from '../lib/data';
import Mountains from '../components/Mountains.astro';
import SearchFilters from '../components/SearchFilters.astro';
import SchoolCta from '../components/SchoolCta.astro';
import { CALENDAR } from '../config';

const now = new Date();
const todayIso = now.toISOString().slice(0, 10);
const upcoming = sessions.filter((s) => s.end >= todayIso).sort((a, b) => a.start.localeCompare(b.start));
const withSession = new Set(upcoming.map((s) => s.schoolId));
const noDates = withOffers('stage').filter((s) => !withSession.has(s.id)).sort((a, b) => a.name.localeCompare(b.name, 'fr'));
const stale = (iso: string | null) => !iso || (now.getTime() - new Date(iso).getTime()) / 864e5 > 14;
const regions = regionCounts('stage').map(([r]) => [r] as [string]);   // every region with a stage school, with or without dates yet
const norm = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const schoolBy = new Map(schools.map((x) => [x.id, x]));
const levelOf = (offerId: string, schoolId: string) => schoolBy.get(schoolId)?.stages.find((o) => o.id === offerId)?.levelKey ?? 'autre';
// data-* attributes understood by the shared filters (src/scripts/filters-lib.js)
const attrs = (x: typeof upcoming[number]) => ({
  'data-name': norm(x.school), 'data-city': norm(x.city ?? ''), 'data-dept': norm(x.dept ?? ''), 'data-region': x.region ?? '',
  'data-near': (schoolBy.get(x.schoolId)?.nearCities ?? []).map(norm).join('|'), 'data-lat': x.lat ?? '', 'data-lng': x.lng ?? '',
  'data-levels': levelOf(x.offerId, x.schoolId), 'data-start': x.start,
});
const levelCount = (k: string) => upcoming.filter((x) => levelOf(x.offerId, x.schoolId) === k).length;
const levels = LEVELS.filter((l) => l.key !== 'autre').map((l) => ({ key: l.key, name: l.name, n: levelCount(l.key) }));
const monthKeys = [...new Set(upcoming.map((x) => x.start.slice(0, 7)))].sort();
const monthsOpt = monthKeys.map((k) => ({ value: k, label: (() => { const t = dateFr(k + '-01', { month: 'long', year: 'numeric' }); return t.charAt(0).toUpperCase() + t.slice(1); })(), n: upcoming.filter((x) => x.start.startsWith(k)).length }));
const availability = (s: typeof upcoming[number]) =>
  s.status === 'Complet' || s.places === 0 ? 'Complet'
    : s.start < todayIso ? 'Stage en cours'
    : !stale(s.checked) && s.places != null ? `${s.places} place${s.places === 1 ? '' : 's'} à la vérification`
    : 'Places à confirmer auprès de l’école';
const sortOptions = [{ value: 'date', label: 'Date' }, { value: 'distance', label: 'Distance' }, { value: 'nom', label: 'Nom de l’école' }];
const emptyText = upcoming.length === 0
  ? 'Aucune date de stage n’est publiée pour le moment. Les écoles listées plus bas peuvent vous donner leurs prochaines sessions.'
  : 'Aucun stage daté dans ce périmètre. Augmentez la distance, changez de niveau ou de région, ou effacez la ville.';
const byMonth = new Map<string, typeof upcoming>();
for (const s of upcoming) { const k = s.start.slice(0, 7); byMonth.set(k, [...(byMonth.get(k) ?? []), s]); }
const monthLabel = (k: string) => { const t = dateFr(k + '-01', { month: 'long', year: 'numeric' }); return t.charAt(0).toUpperCase() + t.slice(1); };
const gridData = upcoming.map((s) => ({ id: s.id, school: s.school, name: s.name, start: s.start, end: s.end, region: s.region, href: sessionHref(s), a: attrs(s) }));
---
<Base title="Calendrier des stages de parapente" description="Les prochains stages de parapente publiés par les écoles en France : dates, prix, lieux. Filtrez par type de stage, mois, ville proche, région ou nom d’école.">
  <div class="page-head"><div class="wrap">
    <h1>Calendrier des stages</h1>
    <p class="lead">Les dates de stage publiées par les écoles, avec leur prix et la date de vérification.</p>
  </div><Mountains /></div>
  <div class="wrap section" style="padding-top:0.5rem">
    <div>
      <SearchFilters regions={regions} levels={levels} months={monthsOpt} allLabel="Tous les stages" allCount={upcoming.length} sort={sortOptions} />
      <div class="board-head" style="margin-top:1rem">
        <span class="muted small" id="cal-count" aria-live="polite">{upcoming.length} stage{upcoming.length > 1 ? 's' : ''} daté{upcoming.length > 1 ? 's' : ''}</span>
        <div class="btn-row" id="view-switch" hidden>
          <button class="btn small" type="button" data-view="grid" aria-pressed="false">Vue calendrier</button>
          <button class="btn small ghost" type="button" data-view="list" aria-pressed="true">Vue liste</button>
        </div>
      </div>
      <div class="empty" id="none" data-all-empty={upcoming.length === 0 ? '1' : undefined} hidden={upcoming.length > 0}>{emptyText}</div>
    </div>
  </div>

  <div class="wrap">
    <section id="grid-view" aria-label="Calendrier mensuel" hidden>
        <div class="cal-bar">
          <button class="btn small ghost" type="button" id="prev" aria-label="Mois précédent">Mois précédent</button>
          <h2 id="month-title" style="margin:0" aria-live="polite"></h2>
          <button class="btn small ghost" type="button" id="next" aria-label="Mois suivant">Mois suivant</button>
        </div>
        <div class="cal-grid" id="cal"></div>
        <p class="small muted">Sur petit écran, utilisez la vue liste.</p>
    </section>

    <section id="list-view" aria-label="Liste des stages datés">
      <ul class="board" id="flat-list" hidden></ul>
      {[...byMonth.entries()].map(([k, list]) => (
        <div class="month-block" data-month={k} style="margin-bottom:2rem">
          <h2>{monthLabel(k)}</h2>
          <ul class="board">
            {list.map((s) => (
              <li data-session data-start={s.start} data-idx={upcoming.indexOf(s)} {...attrs(s)}>
                <div class="session">
                  <span class="when">{dateFr(s.start, { day: 'numeric', month: 'short' })} au {dateFr(s.end, { day: 'numeric', month: 'short' })}</span>
                  <span><a href={sessionHref(s)}><strong>{s.school}</strong></a> : {s.name}<br />
                    <span class="muted small">{s.city}{s.dept ? `, ${s.dept}` : ''} · {s.days} jour{(s.days ?? 0) > 1 ? 's' : ''}<span class="dist"></span></span>
                    <br /><span class="small">{availability(s)}</span>{stale(s.checked) && <><br /><span class="stale">À confirmer : date non vérifiée depuis plus de 14 jours</span></>}
                  </span>
                  <strong>{s.priceLabel ?? (s.price ? eur(s.price) : '')}</strong>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="section" style="padding-bottom:0">
      <h2>Écoles sans dates publiées</h2>
      <p>Ces écoles proposent des stages mais n’affichent pas de dates en ligne. Contactez-les pour connaître les prochaines sessions.</p>
      <details class="more" open={upcoming.length < CALENDAR.minSessions}><summary>Voir les <span id="nodates-count">{noDates.length}</span> écoles</summary>
        <ul class="sites" style="margin-top:0.8rem" id="nodates">{noDates.map((s) => <li data-nodate data-name={norm(s.name)} data-city={norm(s.city ?? '')} data-dept={norm(s.dept ?? '')} data-region={s.region ?? ''} data-near={s.nearCities.map(norm).join('|')} data-lat={s.lat ?? ''} data-lng={s.lng ?? ''} data-levels={[...new Set(s.stages.map((o) => o.levelKey))].join(' ')}><a href={`/ecoles/${s.slug}/?parcours=stage`}>{s.name}</a></li>)}</ul>
      </details>
    </section>
  </div>

  <div class="wrap"><SchoolCta type="stage" /></div>
  <script type="application/json" id="sessions-data" set:html={JSON.stringify(gridData)} />
  <script>
    import { makeFilters, readItem } from '../scripts/filters-lib.js';
    const dataEl = document.getElementById('sessions-data');
    const all = dataEl ? JSON.parse(dataEl.textContent) : [];
    const listView = document.getElementById('list-view');
    const gridView = document.getElementById('grid-view');
    const cal = document.getElementById('cal');
    const form = document.getElementById('filters');
    const F = form ? makeFilters(form) : null;
    let st = null;
    let cursor = all.length ? new Date(all[0].start + 'T12:00:00') : new Date();
    cursor.setDate(1);

    const esc = (t) => String(t ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const fmtMonth = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' });
    const iso = (d) => [d.getFullYear(), String(d.getMonth() + 1).padStart(2, '0'), String(d.getDate()).padStart(2, '0')].join('-');
    const toItem = (a) => ({ name: a['data-name'], city: a['data-city'], dept: a['data-dept'], region: a['data-region'], near: (a['data-near'] || '').split('|').filter(Boolean),
      lat: parseFloat(a['data-lat']), lng: parseFloat(a['data-lng']), levels: (a['data-levels'] || '').split(' ').filter(Boolean), start: a['data-start'] || '' });
    const okSession = (s) => !F || !st || F.match(toItem(s.a), st).ok;

    const none = document.getElementById('none');
    const noneDefault = none ? none.textContent : '';
    const flat = document.getElementById('flat-list');
    const monthLists = listView ? [...listView.querySelectorAll('.month-block')] : [];
    const sessionLis = listView ? [...listView.querySelectorAll('li[data-session]')] : [];

    function applyFilters() {
      st = F ? F.state() : null;
      let shown = 0;
      const rows = sessionLis.map((li) => {
        const r = F ? F.match(readItem(li), st) : { ok: true, d: null };
        li.hidden = !r.ok; if (r.ok) shown++;
        const dist = li.querySelector('.dist'); if (dist) dist.textContent = r.ok && r.d !== null ? ` · à ${Math.round(r.d)} km` : '';
        return { li, d: r.d, name: li.dataset.name, idx: Number(li.dataset.idx) };
      });
      // Sort: by date keeps the month blocks; by distance or by name shows one flat list
      const by = st && st.sort === 'nom' ? (a, b) => a.name.localeCompare(b.name, 'fr') || a.idx - b.idx
        : st && st.sort === 'distance' && st.from ? (a, b) => (a.d ?? 1e9) - (b.d ?? 1e9) || a.idx - b.idx
        : null;
      if (by && flat) {
        rows.sort(by).forEach((r) => flat.appendChild(r.li));
        flat.hidden = false; monthLists.forEach((b) => (b.hidden = true));
      } else {
        if (flat) flat.hidden = true;
        rows.sort((a, b) => a.idx - b.idx);
        // put every session back in its own month, in date order
        for (const b of monthLists) { const ul = b.querySelector('ul'); const own = rows.filter((r) => b.dataset.month === r.li.dataset.start.slice(0, 7)); own.forEach((r) => ul.appendChild(r.li)); }
        monthLists.forEach((b) => (b.hidden = ![...b.querySelectorAll('li[data-session]')].some((li) => !li.hidden)));
      }
      let nd = 0;
      document.querySelectorAll('#nodates li[data-nodate]').forEach((li) => { const r = F.match(readItem(li), st); li.hidden = !r.ok; if (r.ok) nd++; });
      const ndc = document.getElementById('nodates-count'); if (ndc) ndc.textContent = nd;
      const c = document.getElementById('cal-count'); if (c) c.textContent = `${shown} stage${shown > 1 ? 's' : ''} daté${shown > 1 ? 's' : ''}`;
      if (none) { none.textContent = noneDefault; none.hidden = shown !== 0 && all.length > 0; }
      if (cal) drawGrid();
    }

    function drawGrid() {
      const y = cursor.getFullYear(), m = cursor.getMonth();
      document.getElementById('month-title').textContent = fmtMonth.format(cursor).replace(/^./, (c) => c.toUpperCase());
      const first = new Date(y, m, 1, 12);
      const offset = (first.getDay() + 6) % 7; // Monday first
      const days = new Date(y, m + 1, 0).getDate();
      let html = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'].map((d) => `<div class="dow">${d}</div>`).join('');
      for (let i = 0; i < offset; i++) html += '<div class="day out"></div>';
      for (let d = 1; d <= days; d++) {
        const key = iso(new Date(y, m, d, 12));
        const ev = all.filter((s) => okSession(s) && s.start <= key && s.end >= key);
        html += `<div class="day"><b>${d}</b>${ev.slice(0, 3).map((s) => `<a class="cal-ev" href="${esc(s.href)}" title="${esc(s.school)} : ${esc(s.name)}"><b>${esc(s.school)}</b><small>${esc(s.name)}</small></a>`).join('')}${ev.length > 3 ? `<span class="muted">+${ev.length - 3}</span>` : ''}</div>`;
      }
      cal.innerHTML = html;
    }

    function setView(v) {
      document.querySelectorAll('#view-switch button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === v)));
      if (gridView) gridView.hidden = v !== 'grid';
      if (listView) listView.hidden = v === 'grid';
    }

    if (gridView) {
      document.getElementById('view-switch').hidden = false;
      F?.els.sort?.addEventListener('change', () => setView(F.els.sort.value === 'date' ? 'grid' : 'list'));
      document.getElementById('prev').addEventListener('click', () => { cursor.setMonth(cursor.getMonth() - 1); drawGrid(); });
      document.getElementById('next').addEventListener('click', () => { cursor.setMonth(cursor.getMonth() + 1); drawGrid(); });
      document.querySelectorAll('#view-switch button').forEach((b) => b.addEventListener('click', () => setView(b.dataset.view)));
      setView('list');
    }
    F?.els.month?.addEventListener('change', () => { const m = F.els.month.value; if (m) { cursor = new Date(m + '-01T12:00:00'); if (cal) drawGrid(); } });
    if (F) F.bind(applyFilters, (msg) => { if (none) { none.textContent = msg; none.hidden = false; } });
    else { st = null; if (cal) drawGrid(); }
  </script>
</Base>
