---
import DocPage from '../../components/DocPage.astro';
import rawSchools from '../../../legal/pages/conditions-ecoles-en.html?raw';

const html = rawSchools
  .replace(/\{\{cgvUrl\}\}/g, '/en/terms-and-conditions/')
  .replace(/\{\{privacyUrl\}\}/g, '/en/privacy-policy/');
---
<DocPage
  title="Terms for schools"
  h1="Listing Agreement for Paragliding Schools"
  description="Terms applicable to paragliding schools listed on ResaParapente: free publication of offers, booking and gift requests."
>
  <p class="muted">Version of 22 November 2026</p>
  <div set:html={html} />
</DocPage>
<style>
  :global(mark.todo) { background: #fef08a; color: #713f12; padding: 0.05em 0.3em; border-radius: 4px; font-weight: 600; }
</style>
