---
import DocPage from '../../components/DocPage.astro';
import rawPrivacy from '../../../legal/pages/confidentialite-en.html?raw';

const html = rawPrivacy
  .replace(/\{\{cgvUrl\}\}/g, '/en/terms-and-conditions/')
  .replace(/\{\{privacyUrl\}\}/g, '/en/privacy-policy/');
---
<DocPage
  title="Privacy policy"
  h1="Privacy Policy"
  description="What personal data ResaParapente collects, why, who it is shared with, how long it is kept and how to exercise your rights."
>
  <p class="muted">Version of 22 November 2026</p>
  <div set:html={html} />
</DocPage>
<style>
  :global(mark.todo) { background: #fef08a; color: #713f12; padding: 0.05em 0.3em; border-radius: 4px; font-weight: 600; }
</style>
