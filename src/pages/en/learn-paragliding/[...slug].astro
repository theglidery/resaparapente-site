---
import ArticlePage from '../../../components/ArticlePage.astro';
import { LEARN_PAGES_EN } from '../../../data/learn-en';

export function getStaticPaths() {
  return LEARN_PAGES_EN.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}
const { article } = Astro.props;
const alternates = [
  { locale: 'fr' as const, href: `/apprendre/${article.frSlug}/` },
  { locale: 'en' as const, href: `/en/learn-paragliding/${article.slug}/` },
];
---
<ArticlePage article={article} cta="stage" locale="en" alternates={alternates} />
