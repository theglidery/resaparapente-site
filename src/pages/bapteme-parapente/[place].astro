---
import PlacePage from '../../components/PlacePage.astro';
import { placesFor } from '../../lib/places';
export function getStaticPaths() { return placesFor('bapteme').map((place) => ({ params: { place: place.slug }, props: { place } })); }
const { place } = Astro.props;
---
<PlacePage kind="bapteme" place={place} />
