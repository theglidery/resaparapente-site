---
import CountryNav from './CountryNav.astro';
import BrandLogo from './BrandLogo.astro';
import { SITE } from '../config';
import { STAGE_TYPES } from '../data/stage-types';
import { WHY_MENU, WHY_ROOT } from '../data/why-fly';
import { LEARN_MENU } from '../data/learn';
import { href, alternatesOf, type Locale } from '../i18n/ui';
import { PAGES } from '../i18n/routes.mjs';

const { current, enHref, locale = 'fr', pageKey, alternates: altProp } = Astro.props as {
  current: string;
  enHref?: string;
  locale?: Locale;
  pageKey?: keyof typeof PAGES;
  alternates?: { locale: Locale; href: string }[];
};

const isEn = locale === 'en';
const homeHref = isEn ? '/en/' : '/';

type SubItem = { href: string; label: string; children?: { href: string; label: string }[] };

const stageSub: SubItem[] = isEn
  ? [
      { href: '/en/paragliding-course-schools/', label: 'Find / Book My Course' },
      { href: href('trainingCost', 'en'), label: 'Course Comparator' },
      { href: '/en/paragliding-course-calendar/', label: 'Upcoming courses - Calendar' },
      { href: href('trainingCost', 'en'), label: 'Cost of full training' },
      { href: href('whenStart', 'en'), label: 'When can I start?' },
    ]
  : [
      { href: '/stage/', label: 'Trouver / Réserver mon stage' },
      { href: '/comparateur-prix-formation-parapente/', label: 'Comparateur de stages' },
      { href: '/comparateur-prix-formation-parapente/', label: 'Coût d’une formation complète' },
      { href: '/calendrier/', label: 'Prochains stages - Calendrier' },
      { href: '/quand-commencer-parapente/', label: 'Quand commencer ?' },
      {
        href: '/stage/',
        label: 'Choisir le bon stage',
        children: STAGE_TYPES.map((t) => ({ href: `/stage/${t.slug}/`, label: t.menu })),
      },
    ];

const GUIDE = '/bapteme/biplace-saut-en-parapente/';
const baptemeSub = isEn
  ? [
      { href: '/en/tandem-paragliding-schools/', label: 'Find a tandem flight' },
      { href: href('baptemeCompare', 'en'), label: 'Tandem flight comparison' },
      { href: href('baptemeGuide', 'en'), label: 'Which flight to choose?' },
      { href: href('jump', 'en'), label: 'Tandem paragliding jump' },
      { href: href('giftChristmas', 'en'), label: 'Gift voucher' },
    ]
  : [
      { href: '/bapteme/', label: 'Trouver un baptême' },
      { href: '/comparateur-baptemes-parapente/', label: 'Comparateur de baptêmes' },
      { href: '/quel-bapteme-parapente-choisir/', label: 'Quel baptême choisir ?' },
      { href: '/saut-en-parapente/', label: 'Saut en parapente' },
      { href: GUIDE, label: 'Biplace : le guide' },
      { href: '/bon-cadeau-parapente-noel/', label: 'Bon cadeau pour Noël' },
    ];

const whyItems = isEn
  ? [
      { href: '/pourquoi-voler/', label: 'Why fly? (FR)' },
      { href: '/pourquoi-voler/les-plaisirs-du-parapente/', label: 'The joys of paragliding (FR)' },
      { href: '/pourquoi-voler/histoire-du-parapente/', label: 'History of paragliding (FR)' },
    ]
  : WHY_MENU;

const learnItems = isEn
  ? [
      { href: href('trainingPath', 'en'), label: 'Pathway and licences' },
      { href: '/apprendre/', label: 'Learn paragliding (FR)' },
      { href: '/apprendre/premier-stage/', label: 'Prepare your first course (FR)' },
      { href: '/apprendre/brevets/', label: 'Licences & ratings (FR)' },
      { href: '/apprendre/cours/', label: 'Theory modules (FR)' },
    ]
  : [
      { href: '/cursus-brevets-parapente/', label: 'Parcours et brevets' },
      ...LEARN_MENU,
    ];

const giftSub: SubItem[] = isEn
  ? [
      { href: href('giftChristmas', 'en'), label: 'Tandem flight' },
      { href: '/en/give-a-course/', label: 'Courses' },
    ]
  : [
      { href: '/bon-cadeau-parapente-noel/', label: 'Baptême' },
      { href: '/offrir-un-stage/', label: 'Stages' },
    ];

const links = isEn
  ? [
      { href: '/en/tandem-paragliding-schools/', label: 'Book a Tandem Flight', sub: baptemeSub },
      { href: '/en/paragliding-course-schools/', label: 'Book a Course', sub: stageSub },
      { href: href('giftChristmas', 'en'), label: 'Gift Voucher', sub: giftSub },
      { href: '/en/christmas-offer/', label: 'Christmas Offer' },
      { href: '/apprendre/', label: 'Learn Paragliding', sub: learnItems },
      { href: WHY_ROOT, label: 'Why Fly', sub: whyItems },
    ]
  : [
      { href: '/bapteme/', label: 'Réserver un Baptême', sub: baptemeSub },
      { href: '/stage/', label: 'Réserver son Stage', sub: stageSub },
      { href: '/bon-cadeau-parapente-noel/', label: 'Bon cadeau', sub: giftSub },
      { href: '/offre-noel/', label: 'Offre Noël' },
      { href: '/apprendre/', label: 'Apprendre le parapente', sub: learnItems },
      { href: WHY_ROOT, label: 'Pourquoi voler', sub: whyItems },
    ];

const isCurrent = (l: { href: string; sub?: { href: string }[] }) =>
  current.startsWith(l.href) || (l.sub?.some((x) => x.href !== '/' && current.startsWith(x.href)) ?? false);

const alternates = altProp ?? (pageKey ? alternatesOf(pageKey) : []);
const frHref = alternates.find((a) => a.locale === 'fr')?.href ?? '/';
const targetEnHref = enHref ?? alternates.find((a) => a.locale === 'en')?.href ?? '/en/';
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={homeHref} aria-label={`${SITE.name} : ${isEn ? 'home' : 'accueil'}`}>
      {isEn ? <BrandLogo /> : <img src="/images/brand/logo.png" srcset="/images/brand/logo.png 1x, /images/brand/logo@2x.png 2x" alt={SITE.name} width="200" height="42" />}
    </a>
    <nav class="nav" aria-label={isEn ? 'Main navigation' : 'Navigation principale'}>
      <ul>
        {links.map((l) => (
          <li class={l.sub ? 'has-sub' : undefined}>
            <a href={l.href} aria-current={isCurrent(l) ? 'page' : undefined} aria-haspopup={l.sub ? 'true' : undefined}>{l.label}{l.sub && <span class="caret" aria-hidden="true"></span>}</a>
            {l.sub && (
              <ul class="sub">
                {l.sub.map((x: SubItem) => (
                  <li class={x.children ? 'has-sub2' : undefined}>
                    <a href={x.href} aria-current={current === x.href ? 'page' : undefined}>{x.label}{x.children && ' ›'}</a>
                    {x.children && (
                      <ul class="sub2">
                        {x.children.map((ch) => <li><a href={ch.href} aria-current={current === ch.href ? 'page' : undefined}>{ch.label}</a></li>)}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    {(targetEnHref || isEn) && (
      <nav class="lang-switch" aria-label={isEn ? 'Language' : 'Langue'}>
        <a href={frHref} hreflang="fr" lang="fr" aria-current={!isEn ? 'true' : undefined}>FR</a>
        <a href={targetEnHref} hreflang="en" lang="en" aria-current={isEn ? 'true' : undefined}>EN</a>
      </nav>
    )}
    <CountryNav />
  </div>
</header>
<style>
  .nav .has-sub2 { position: relative; }
  .nav .sub2 {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0.35rem 0;
    min-width: 15rem;
    background: var(--white, #fff);
    border: 1px solid var(--line, #dbe2ea);
    border-radius: 10px;
    box-shadow: 0 12px 28px rgba(13, 36, 56, 0.14);
  }
  @media (min-width: 980px) {
    .nav .sub2 { position: absolute; left: 100%; top: -0.35rem; z-index: 60; }
    .nav .has-sub2:hover > .sub2,
    .nav .has-sub2:focus-within > .sub2 { display: block; }
  }
  @media (max-width: 979px) {
    .nav .sub2 { display: block; position: static; box-shadow: none; border: 0; padding-left: 0.9rem; }
  }
</style>

<script>
  const why = document.querySelector<HTMLDetailsElement>('#why-navigation');
  if (why) {
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !why.contains(event.target)) why.open = false;
    });
    why.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && why.open) {
        why.open = false;
        why.querySelector('summary')?.focus();
      }
    });
  }
</script>
