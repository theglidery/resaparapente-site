---
// The one filter form used on the baptême list, the stage list and the stage calendar.
import { cities, schools, reviewStats } from '../lib/data';
import { REVIEWS, MARKET } from '../config';
interface Props { regions: [string, number?][]; levels?: { key: string; name: string; n?: number }[]; months?: { value: string; label: string; n?: number }[]; allLabel?: string; allCount?: number; sort?: { value: string; label: string }[]; flags?: { key: string; label: string }[]; action?: string; selectedRegion?: string; selectedCountry?: string; locale?: 'fr' | 'en' | 'de' }
const anyRated = schools.some((x) => (reviewStats(x.id)?.count ?? 0) >= REVIEWS.minOnCard);
const { regions, levels = [], months = [], allLabel = 'Tous les stages', allCount, sort, flags = [], action = '.', selectedRegion = '', selectedCountry = MARKET.code, locale = 'fr' } = Astro.props;
const isEn = locale === 'en';
const defaultSort = isEn
  ? [{ value: 'distance', label: 'Distance' }, { value: 'prix', label: 'Lowest price' }, ...(anyRated ? [{ value: 'note', label: 'Top rated' }] : []), { value: 'nom', label: 'School name' }]
  : [{ value: 'distance', label: 'Distance' }, { value: 'prix', label: 'Prix le plus bas' }, ...(anyRated ? [{ value: 'note', label: 'Mieux notées' }] : []), { value: 'nom', label: 'Nom de l’école' }];
const activeSort = sort ?? defaultSort;
const metroRegions = regions.filter(([r]) => r !== 'Outre-mer').sort((a, b) => a[0].localeCompare(b[0], 'fr'));
const outreMerRegions = regions.filter(([r]) => r === 'Outre-mer');
const regionCountryMap = Object.fromEntries(schools.filter((s) => s.region && s.region !== 'À vérifier').map((s) => [s.region as string, s.country || 'FR']));
---
<form id="filters" class="filters" action={action} method="get" role="search" aria-label={isEn ? 'Filter' : 'Filtrer'}>
  <div class="field">
    <label for="pays">{isEn ? 'Country' : 'Pays'}</label>
    <select id="pays" name="pays">
      <option value="FR" selected={selectedCountry === 'FR'}>France</option>
      <option value="CH" selected={selectedCountry === 'CH'}>{isEn ? 'Switzerland' : 'Suisse'}</option>
      <option value="BE" selected={selectedCountry === 'BE'}>{isEn ? 'Belgium' : 'Belgique'}</option>
      <option value="all" selected={selectedCountry === 'all'}>{isEn ? 'All countries' : 'Tous les pays'}</option>
    </select>
  </div>
  <div class="field">
    <label for="lang">{isEn ? 'School language' : 'Langue de l’école'}</label>
    <select id="lang" name="lang">
      <option value="">{isEn ? 'All languages' : 'Toutes les langues'}</option>
      <option value="Français">{isEn ? 'French' : 'Français'}</option>
      <option value="Anglais">{isEn ? 'English' : 'Anglais'}</option>
      <option value="Allemand">{isEn ? 'German' : 'Allemand'}</option>
      <option value="Italien">{isEn ? 'Italian' : 'Italien'}</option>
    </select>
  </div>
  <div class="field">
    <label for="region">{isEn ? 'Region' : 'Région'}</label>
    <select id="region" name="region">
      <option value="">{isEn ? 'All regions' : 'Toutes les régions'}</option>
      {outreMerRegions.length > 0 ? (
        <>
          <optgroup label={isEn ? 'Mainland France' : 'France métropolitaine'}>
            {metroRegions.map(([r, n]) => <option value={r} data-country={regionCountryMap[r] || 'FR'} selected={r === selectedRegion}>{r}{n !== undefined ? ` (${n})` : ''}</option>)}
          </optgroup>
          <optgroup label={isEn ? 'Overseas' : 'Outre-mer'}>
            {outreMerRegions.map(([r, n]) => <option value={r} data-country={regionCountryMap[r] || 'FR'} selected={r === selectedRegion}>{r}{n !== undefined ? ` (${n})` : ''}</option>)}
          </optgroup>
        </>
      ) : metroRegions.map(([r, n]) => <option value={r} data-country={regionCountryMap[r] || 'FR'} selected={r === selectedRegion}>{r}{n !== undefined ? ` (${n})` : ''}</option>)}
    </select>
  </div>
  <div class="field">
    <label for="q">{isEn ? 'Near which city?' : 'Près de quelle ville ?'}</label>
    <input id="q" name="q" type="search" list="cities" autocomplete="off" placeholder="Annecy, Chambéry, Lyon, Chamonix…" />
    <datalist id="cities">{cities.map((c) => <option value={c.name} />)}</datalist>
  </div>
  <div class="field">
    <label for="r">{isEn ? 'Max distance' : 'Distance maximale'}</label>
    <select id="r" name="r">
      <option value="">{isEn ? 'No limit' : 'Pas de limite'}</option>
      <option value="25">25 km</option><option value="50" selected>50 km</option><option value="100">100 km</option><option value="200">200 km</option>
    </select>
  </div>
  {months.length > 0 && (
    <div class="field">
      <label for="month">{isEn ? 'Month' : 'Mois'}</label>
      <select id="month" name="month">
        <option value="">{isEn ? 'All months' : 'Tous les mois'}</option>
        {months.map((m) => <option value={m.value}>{m.label}{m.n !== undefined ? ` (${m.n})` : ''}</option>)}
      </select>
    </div>
  )}
  <div class="field">
    <label for="school">{isEn ? 'School name' : 'Nom de l’école'}</label>
    <input id="school" name="school" type="search" autocomplete="off" placeholder={isEn ? 'Part of the name is enough' : 'Une partie du nom suffit'} />
  </div>
  {activeSort.length > 0 && (
    <div class="field">
      <label for="sort">{isEn ? 'Sort by' : 'Trier par'}</label>
      <select id="sort" name="sort">
        {activeSort.map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
    </div>
  )}
  {flags.length > 0 && (
    <div class="flag-row" role="group" aria-label={isEn ? 'Criteria' : 'Critères'}>
      {flags.map((f) => <label class="flag"><input type="checkbox" name={f.key} data-flag={f.key} value="1" /> <span>{f.label}</span></label>)}
    </div>
  )}
  {levels.length > 0 && (
    <div style="grid-column: 1 / -1">
      <input type="hidden" id="level" name="level" value="" />
      <div class="type-chips" id="type-chips" role="group" aria-label={isEn ? 'Course type' : 'Type de stage'}>
        <button type="button" class="chip" data-level="" aria-pressed="true">{allLabel}{allCount !== undefined && <span class="n">{allCount}</span>}</button>
        {levels.map((l) => <button type="button" class={`chip${l.n === 0 ? ' zero' : ''}`} data-level={l.key} aria-pressed="false">{l.name}{l.n !== undefined && <span class="n">{l.n}</span>}</button>)}
      </div>
    </div>
  )}
  <div class="btn-row">
    <button class="btn" type="submit">{isEn ? 'Search' : 'Rechercher'}</button>
    <button class="btn ghost" type="button" id="geo" hidden>{isEn ? 'Near me' : 'Autour de moi'}</button>
    <button class="btn ghost" type="reset" id="reset">{isEn ? 'Reset' : 'Effacer'}</button>
  </div>
</form>
<script type="application/json" id="towns-data" set:html={JSON.stringify(cities.map(({ name, lat, lng, region, ...rest }: any) => ({ name, lat, lng, region, country: rest.country || 'FR' })))} />
