---
import { MARKET, marketLinks } from '../config';
---
<nav class="country-nav" aria-label="Choisir un pays">
  {marketLinks.map((country) => (
    <a href={country.href} aria-current={MARKET.code === country.code ? 'true' : undefined} lang={country.locale}>
      {country.label}
    </a>
  ))}
</nav>
