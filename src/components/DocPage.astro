---
// Text pages (legal notices, terms, about, contact): one readable column, same header and footer as the rest of the site.
import Base from '../layouts/Base.astro';
import Mountains from './Mountains.astro';
interface Props { title: string; description: string; h1?: string; lead?: string; noindex?: boolean; jsonLd?: object }
const { title, description, h1, lead, noindex, jsonLd } = Astro.props;
---
<Base title={title} description={description} noindex={noindex} jsonLd={jsonLd}>
  <div class="page-head"><div class="wrap">
    <nav class="crumbs" aria-label="Fil d’Ariane"><a href="/">Accueil</a> / {h1 ?? title}</nav>
    <h1>{h1 ?? title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div><Mountains /></div>
  <div class="wrap section doc"><slot /></div>
</Base>
