---
// One school as a card: photo, logo, name, where, number of formulas and starting price.
import Logo from './Logo.astro';
import { eur, currencyOf, dateFr, fromPrice, offerPrice, LEVELS, giftsOf, promosOf, type School } from '../lib/data';
import { money } from '../lib/compare';
import { schoolImages } from '../lib/images';
import { kidsOf, winterOf } from '../lib/places';
import { reviewStats } from '../lib/data';
import { REVIEWS } from '../config';

interface Props { school: School; kind: 'bapteme' | 'stage'; locale?: 'fr' | 'en' | 'de' }
const { school: s, kind, locale = 'fr' } = Astro.props;
const isEn = locale === 'en';
const cur = currencyOf(s);
const list = kind === 'bapteme' ? s.baptemes : s.stages;
const price = fromPrice(s, kind);
const { logo, main } = schoolImages(s);
const norm = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const byLevel: Record<string, { n: number; p: number | null }> = {};
if (kind === 'stage') for (const l of LEVELS) {
  const os = s.stages.filter((o) => o.levelKey === l.key);
  if (os.length) { const ps = os.map(offerPrice).filter((v): v is number => v != null); byLevel[l.key] = { n: os.length, p: ps.length ? Math.min(...ps) : null }; }
}
// Partner promotion running today (price + essential conditions, no badge, no effect on the order of the list)
const ids = new Set(list.map((o) => o.id));
const promo = promosOf(s.id).filter((p) => !p.offerId || ids.has(p.offerId)).sort((a, b) => a.price - b.price)[0];
const gift = giftsOf(s.id).some((x) => !x.kind || x.kind === 'Baptême et stage' || x.kind === 'Montant libre' || x.kind === (kind === 'bapteme' ? 'Baptême' : 'Stage'));
const hasKids = kind === 'bapteme' && list.some(kidsOf);
const hasWinter = kind === 'bapteme' && list.some(winterOf);
const flags = [hasKids && 'kids', hasWinter && 'winter', gift && 'gift'].filter(Boolean).join(' ');

const profSet = new Set(kind === 'bapteme' ? s.baptemes.flatMap((o) => o.cmp?.profiles ?? []) : []);
const cardTags: string[] = [];
if (kind === 'bapteme') {
  if (profSet.has('Première fois')) cardTags.push(isEn ? 'Discovery' : 'Découverte');
  if (profSet.has('Longue durée')) cardTags.push(isEn ? 'Long flight' : 'Vol long');
  if (profSet.has('Sensations')) cardTags.push(isEn ? 'Thrill' : 'Sensations');
  if (hasKids || profSet.has('Enfant')) cardTags.push(isEn ? 'Child-friendly' : 'Enfants acceptés');
  if (hasWinter) cardTags.push(isEn ? 'Winter flights' : 'Vol en hiver');
}

const rv = reviewStats(s.id);
const rated = rv && rv.count >= REVIEWS.minOnCard ? rv : null;
const near = s.mainCity && s.mainCity !== s.city ? (isEn ? `near ${s.mainCity}` : `près de ${s.mainCity}`) : '';
const n = list.length;

const EN_LEVEL_SHORT: Record<string, string> = {
  decouverte: 'Discovery',
  initiation: 'Initiation',
  progression: 'Progression',
  perfectionnement: 'Advanced',
  siv: 'SIV',
  encadre: 'Guided flights',
  'marche-vol': 'Hike & fly',
  voyage: 'Trips',
};

let meta = '';
if (kind === 'bapteme') {
  const d = s.baptemes.flatMap((o) => [o.durMin, o.durMax]).filter((v): v is number => typeof v === 'number' && v > 0);
  if (d.length) {
    const a = Math.min(...d), b = Math.max(...d);
    meta = isEn
      ? (a === b ? `${a} min flight` : `${a} to ${b} min flights`)
      : (a === b ? `Vol de ${a} min` : `Vols de ${a} à ${b} min`);
  }
} else {
  const names = LEVELS.filter((l) => byLevel[l.key] && l.key !== 'autre').map((l) => (isEn ? EN_LEVEL_SHORT[l.key] || l.name : l.name.split(',')[0]));
  meta = names.slice(0, 3).join(' · ');
}

const cardHref = isEn ? `/en/schools/${s.slug}/` : `/ecoles/${s.slug}/?parcours=${kind}`;
const fmtPrice = (v: number) => (isEn ? money(v, 'en', cur) : eur(v, cur));
---
<li class="school-li"
    data-name={norm(s.name)} data-city={norm(s.city ?? '')} data-dept={norm(s.dept ?? '')} data-region={s.region ?? ''} data-country={s.country ?? 'FR'} data-currency={cur} data-lang={norm(s.fiche?.langues ?? '')}
    data-near={s.nearCities.map(norm).join('|')} data-lat={s.lat ?? ''} data-lng={s.lng ?? ''} data-price={price ?? ''} data-rating={rated ? rated.avg : ''} data-reviews={rated ? rated.count : ''}
    data-flags={flags} data-levels={Object.keys(byLevel).join(' ')} data-bylevel={kind === 'stage' ? JSON.stringify(byLevel) : undefined}>
  <a class="card" data-track="select_school" data-school={s.id} data-kind={kind} href={cardHref}>
    <span class={`card-media${main ? '' : ' none'}`}>
      {main && <img src={main.src} alt="" loading="lazy" decoding="async" width="480" height="320" />}
      <span class="card-logo"><Logo name={s.name} src={logo} /></span>
    </span>
    <span class="card-body">
      <span class="name">{s.name}</span>
      <span class="where">{s.dept ?? s.city}{near ? ` · ${near}` : ''}<span class="dist"></span></span>
      {rated && <span class="meta rate"><span class="stars" aria-hidden="true">★</span> <strong>{rated.avg.toLocaleString(isEn ? 'en-GB' : 'fr-FR', { minimumFractionDigits: 1 })}</strong> ({rated.count} {isEn ? 'reviews' : 'avis'})</span>}
      {meta && <span class="meta">{meta}</span>}
      {s.fiche?.langues && <span class="meta small muted">{isEn ? 'Languages:' : 'Langues :'} {s.fiche.langues}</span>}
      {cardTags.length > 0 && <span class="tags">{cardTags.map((t) => <span class="tag-s">{t}</span>)}</span>}
      {promo && <span class="promo-line" data-promo data-end={promo.end}><strong>{promo.title ?? (isEn ? 'Offer' : 'Offre')} : {fmtPrice(promo.price)}</strong>{promo.regular && <> <s>{fmtPrice(promo.regular)}</s></>} · {isEn ? 'until' : 'jusqu’au'} {dateFr(promo.end, { day: 'numeric', month: 'long' })}{promo.conditions ? ` · ${promo.conditions}` : ''}</span>}
      {gift && <span class="gift-line">{isEn ? 'School gift voucher' : 'Bon cadeau proposé par l’école'}</span>}
    </span>
    <span class="card-foot">
      <span class="count">{n} {isEn ? (kind === 'stage' ? (n > 1 ? 'courses' : 'course') : (n > 1 ? 'packages' : 'package')) : `formule${n > 1 ? 's' : ''}`}</span>
      <span class="price">
        <span class="price-main">{price !== null ? (isEn ? `from ${fmtPrice(price)}` : `dès ${fmtPrice(price)}`) : (isEn ? 'price on request' : 'prix selon formule')}</span>
        <small class="price-sub">{price !== null ? (isEn ? 'per person' : 'par personne') : ''}</small>
      </span>
    </span>
  </a>
</li>
