---
// Layout of the editorial pages (baptême guide, learning pages). Optional slots: "after-brief", "after-sections".
import { SITE } from '../config';
import Base from '../layouts/Base.astro';
import Mountains from './Mountains.astro';
import Sections from './Sections.astro';
import SchoolCta from './SchoolCta.astro';
import type { Article } from '../data/article-types';
interface Props { article: Article; cta?: 'stage' | 'bapteme' | null }
const { article: a, cta = null } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, SITE.url).href;
const crumbs = [
  { href: '/', label: 'Accueil' },
  ...(a.parent ? [a.parent] : []),
  { href: Astro.url.pathname, label: a.h1 ?? a.title },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article', headline: a.h1 ?? a.title, description: a.description,
      image: a.photo && new URL(a.photo.src, SITE.url).href,
      inLanguage: 'fr-FR', mainEntityOfPage: pageUrl,
      publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
      citation: a.sources?.map((s) => s.href),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((item, i) => ({
        '@type': 'ListItem', position: i + 1, name: item.label, item: new URL(item.href, SITE.url).href,
      })),
    },
    ...(a.faq?.length ? [{
      '@type': 'FAQPage',
      mainEntity: a.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }] : []),
  ],
};
---
<Base title={a.title} description={a.description} jsonLd={jsonLd}>
  <div class="page-head"><div class="wrap">
    <nav class="crumbs" aria-label="Fil d’Ariane">
      {crumbs.map((item, i) => i === crumbs.length - 1
        ? <span aria-current="page">{item.label}</span>
        : <><a href={item.href}>{item.label}</a> / </>)}
    </nav>
    <h1>{a.h1 ?? a.title}</h1>
    <p class="lead">{a.lead}</p>
  </div><Mountains /></div>
  <div class="wrap section type-page" style="padding-top:1.2rem">
    {a.photo && <div class="article-image"><img src={a.photo.src} alt={a.photo.alt} width="1280" height="420" /></div>}
    {a.brief && <ul class="brief">{a.brief.map((b) => <li><b>{b.k}</b>{b.v}</li>)}</ul>}
    <slot name="after-brief" />
    {a.sections.length > 3 && <ul class="toc" aria-label="Sommaire">{a.sections.map((s) => <li><a href={`#${s.id}`}>{s.h}</a></li>)}{a.faq && <li><a href="#faq">Questions fréquentes</a></li>}</ul>}
    <Sections sections={a.sections} />
    <slot name="after-sections" />
    {a.faq && (
      <section id="faq" class="faq" aria-labelledby="h-faq">
        <h2 id="h-faq">Questions fréquentes</h2>
        {a.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    )}
    {a.sources?.length && (
      <section class="article-sources" aria-labelledby="h-sources">
        <h2 id="h-sources">Sources</h2>
        <ul>{a.sources.map((source) => <li><a href={source.href}>{source.label}</a></li>)}</ul>
      </section>
    )}
    {a.next && (
      <section id="suite" aria-labelledby="h-suite">
        <h2 id="h-suite">Pour aller plus loin</h2>
        <ul class="type-grid">{a.next.map((n) => <li><a href={n.href}><strong>{n.label}</strong><span>{n.text}</span></a></li>)}</ul>
      </section>
    )}
    {cta && <SchoolCta type={cta} />}
  </div>
</Base>
